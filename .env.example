# Paths are examples. Create private files outside the repository.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
PULSEPAY_POSTGRES_PASSWORD_FILE=/absolute/path/outside/repository/postgres-password
PULSEPAY_DATABASE_URL_FILE=/absolute/path/outside/repository/database-url
# For a backend started directly instead of Compose.
DATABASE_URL_FILE=/absolute/path/outside/repository/database-url
# Administrative onboarding is disabled until explicitly configured.
# ADMIN_API_TOKEN_FILE=/absolute/path/outside/repository/admin-token
